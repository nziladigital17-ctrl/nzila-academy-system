APP_NAME="Nzila Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nzila_academy
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Sanctum / Authentication ──
SANCTUM_TOKEN_EXPIRATION=1440
# Stateful domains for SPA cookie auth (comma separated, no protocol)
# Local: localhost:5173,localhost:8000,127.0.0.1:8000
# Production: app.dominio.ao,api.dominio.ao
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:8000

# ── Session ──
# Local: leave empty (null)
# Production: .dominio.ao (dot prefix for subdomain sharing)
SESSION_DOMAIN=null
# Local: false (HTTP)
# Production: true (HTTPS only)
SESSION_SECURE_COOKIE=false

# ── CORS ──
# Local: http://localhost:5173
# Production: https://app.dominio.ao
CORS_ALLOWED_ORIGINS=http://localhost:5173

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@nzila-academy.ao"
MAIL_FROM_NAME="${APP_NAME}"
